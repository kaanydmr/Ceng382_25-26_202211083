@page
@model IndexModel
@{
    ViewData["Title"] = "Class Management";
}
<!--
    Promt1:
 

     Page Functionality • On the left side of the page, there will be a form that collects: o Class Name o Student Count o Description • On the right side, there will be a table that displays all the submitted class data. • The table will have the following columns: o Id o Class Name o Student Count o Description o Actions (Edit and Delete) The data should be validated and added to a static list each time the form is submitted. The data will then be displayed in the table. Step 4 – Requirements and Constraints • Use Bootstrap to create a responsive layout with two columns (form on the left, table on the right). • Use Razor Pages only; no JavaScript is allowed. • All operations (Add, Edit, Delete) must be handled using C# methods in the PageModel. • Form validation should be done using C# attributes like [Required], [Range], etc. • When editing, pre-fill the form with the selected item's data. • After deletion or editing, refresh the page and update the table accordingly. Create page according to these
     
     
    Promt2:
    Can you modify page to fix cancel button not working properly?

    Promt3:

    Can you modify page according to new cshtml.cs 

    promt4: 
    make filtering just a 1 searchbox that checks all fields for searched words, numbers...

     
-->

<div class="container-fluid py-4">
    <div class="row">
        <!-- Left Column: Form -->
        <div class="col-md-5 col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@(Model.EditId.HasValue ? "Edit Class" : "Add New Class")</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="@(Model.EditId.HasValue ? "Edit" : "Add")">
                        <input type="hidden" asp-for="EditId" />

                        <div class="mb-3">
                            <label for="ClassName" class="form-label">Class Name</label>
                            <input type="text" class="form-control" id="ClassName" asp-for="ClassInfo.ClassName" required />
                            <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="StudentCount" class="form-label">Student Count</label>
                            <input type="number" class="form-control" id="StudentCount" asp-for="ClassInfo.StudentCount" required />
                            <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" asp-for="ClassInfo.Description" rows="3" required></textarea>
                            <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                @(Model.EditId.HasValue ? "Update" : "Add")
                            </button>

                            @if (Model.EditId.HasValue)
                            {
                                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Filtering Card -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Search Classes</h5>
                </div>
                <div class="card-body">
                    <form method="get" id="filterForm">
                        <div class="mb-3">
                            <label asp-for="TableModel.SearchTerm" class="form-label">Search</label>
                            <input asp-for="TableModel.SearchTerm" class="form-control" placeholder="Search for anything..." />
                        </div>
                        
                        <input type="hidden" asp-for="TableModel.CurrentPage" id="currentPage" value="1" />
                        
                        <!-- Hidden inputs for selected columns -->
                        <div id="selectedColumnsContainer"></div>
                        
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-info">Search</button>
                            
                            <!-- Export button -->
                            <button type="button" id="exportButton" class="btn btn-success">Export JSON</button>
                        </div>
                    </form>
                    
                    <!-- Hidden form for export -->
                    <form method="post" asp-page-handler="Export" id="exportForm" style="display:none;">
                        <input type="hidden" name="searchTerm" value="@Model.TableModel.SearchTerm" />
                        <div id="exportColumnsContainer"></div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Table -->
        <div class="col-md-7 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Class List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="column-header" data-column="ClassName">Class Name</th>
                                    <th class="column-header" data-column="StudentCount">Student Count</th>
                                    <th class="column-header" data-column="Description">Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TableModel.Classes)
                                {
                                    <tr>
                                        <td>@item.ClassName</td>
                                        <td>@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <a asp-page="./Index" asp-route-editId="@item.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                                <input type="hidden" name="deleteId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <!-- Pagination -->
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <p class="mb-0">
                                Showing @((Model.TableModel.CurrentPage - 1) * Model.TableModel.PageSize + 1) to 
                                @Math.Min(Model.TableModel.CurrentPage * Model.TableModel.PageSize, Model.TableModel.TotalItems) 
                                of @Model.TableModel.TotalItems items
                            </p>
                        </div>
                        <div class="col-md-6">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-end mb-0">
                                    @for (int i = 1; i <= Model.TableModel.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.TableModel.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="javascript:void(0)" onclick="changePage(@i)">@i</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize selected columns
        const selectedColumns = [];
        
        function changePage(page) {
            document.getElementById('currentPage').value = page;
            updateSelectedColumnsInForm();
            document.getElementById('filterForm').submit();
            return false;
        }
        
        function updateSelectedColumnsInForm() {
            // Clear existing hidden inputs
            document.getElementById('selectedColumnsContainer').innerHTML = '';
            
            // Add new hidden inputs
            selectedColumns.forEach(column => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedColumns';
                input.value = column;
                document.getElementById('selectedColumnsContainer').appendChild(input);
            });
        }
        
        function highlightColumn(columnName, highlight) {
            // Get the index of the column
            const headers = document.querySelectorAll('.column-header');
            let columnIndex = -1;
            
            for (let i = 0; i < headers.length; i++) {
                if (headers[i].getAttribute('data-column') === columnName) {
                    columnIndex = i;
                    break;
                }
            }
            
            if (columnIndex >= 0) {
                // Get all rows in the table body
                const rows = document.querySelectorAll('tbody tr');
                
                // For each row, highlight or un-highlight the cell at columnIndex
                rows.forEach(row => {
                    const cell = row.cells[columnIndex];
                    if (cell) {
                        if (highlight) {
                            cell.classList.add('highlighted-cell');
                        } else {
                            cell.classList.remove('highlighted-cell');
                        }
                    }
                });
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            // Column header click handlers
            const columnHeaders = document.querySelectorAll('.column-header');
            
            columnHeaders.forEach(header => {
                header.style.cursor = 'pointer';
                
                header.addEventListener('click', function() {
                    const column = this.getAttribute('data-column');
                    
                    if (this.classList.contains('selected-column')) {
                        // Deselect
                        this.classList.remove('selected-column', 'bg-primary', 'text-white');
                        const index = selectedColumns.indexOf(column);
                        if (index > -1) {
                            selectedColumns.splice(index, 1);
                        }
                        highlightColumn(column, false);
                    } else {
                        // Select
                        this.classList.add('selected-column', 'bg-primary', 'text-white');
                        selectedColumns.push(column);
                        highlightColumn(column, true);
                    }
                    
                    updateSelectedColumnsInForm();
                });
            });
            
            // Export button handler
            document.getElementById('exportButton').addEventListener('click', function() {
                // Copy selected columns to export form
                document.getElementById('exportColumnsContainer').innerHTML = '';
                
                selectedColumns.forEach(column => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'selectedColumns';
                    input.value = column;
                    document.getElementById('exportColumnsContainer').appendChild(input);
                });
                
                // Set search term
                document.querySelector('#exportForm input[name="searchTerm"]').value = 
                    document.querySelector('#filterForm input[id="TableModel_SearchTerm"]').value;
                
                // Submit export form
                document.getElementById('exportForm').submit();
            });
            
            // Load any previously selected columns from the model
            @foreach (var column in Model.TableModel.SelectedColumns)
            {
                <text>
                const header = document.querySelector(`.column-header[data-column="${@column}"]`);
                if (header) {
                    header.classList.add('selected-column', 'bg-primary', 'text-white');
                    selectedColumns.push('@column');
                    highlightColumn('@column', true);
                }
                </text>
            }
        });
    </script>
    
    <style>
        .selected-column {
            background-color: #007bff;
            color: white;
        }
        .column-header {
            transition: background-color 0.2s;
        }
        .column-header:hover {
            background-color: #e9ecef;
        }
        .highlighted-cell {
            background-color: rgba(0, 123, 255, 0.1) !important;
            transition: background-color 0.2s;
        }
    </style>
}